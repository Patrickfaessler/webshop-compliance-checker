# Copy to deploy/.env (git-ignored). Never commit real keys or passwords.
# ADR-6: by default scans are NOT stored; they stay in memory for 1 hour and users download PDF/JSON.
# STORE=memory (default) or STORE=postgres (uses DATABASE_URL; switched off for now).
STORE=memory

# --- Database (ADR-5) -------------------------------------------------------
# Default: local PostgreSQL 17 on this machine (see README "Database").
DATABASE_URL=postgresql://checker:<password>@localhost:5432/checker?sslmode=disable
# Separate database for DB tests (tests truncate tables). Leave empty to skip DB tests.
TEST_DATABASE_URL=postgresql://checker:<password>@localhost:5432/checker_test?sslmode=disable
# Superuser password chosen at install time; only for creating the role/databases.
POSTGRES_SUPERUSER_PASSWORD=
CHECKER_DB_PASSWORD=

# Optional: shared Supabase database instead (EU region). Dashboard -> Connect -> "Session pooler",
# not the transaction pooler (port 6543). Copy the exact string; host and region differ per project.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Only for the Docker variant: docker compose -f deploy/docker-compose.yml --profile localdb up -d
POSTGRES_PASSWORD=checker-dev-only

# --- Claude fallback (specs/06-detection-and-ai.md D-4) ---------------------
# Leave key empty to disable the fallback.
ANTHROPIC_API_KEY=
LLM_MODEL_EXTRACT=
LLM_MODEL_SUGGEST=
LLM_DAILY_CALL_BUDGET=200
