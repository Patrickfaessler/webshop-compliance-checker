# Copy to deploy/.env (git-ignored). Never commit real keys or passwords.

# Database: Supabase-hosted PostgreSQL (ADR-5). In the Supabase dashboard:
# Project -> Connect -> "Session pooler" (IPv4, session mode; needed by the River job queue).
# Do NOT use the transaction pooler (port 6543) and do NOT give this string to the Flutter app.
# The line below only shows the shape; copy the exact string from the dashboard (host and region differ per project).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Separate database for DB tests (tests may truncate tables). Leave empty to skip DB tests.
TEST_DATABASE_URL=

# Only for the optional local database: docker compose --profile localdb up -d
# then DATABASE_URL=postgresql://checker:checker-dev-only@localhost:5432/checker?sslmode=disable
POSTGRES_PASSWORD=checker-dev-only

# Claude fallback (specs/06-detection-and-ai.md D-4). Leave key empty to disable the fallback.
ANTHROPIC_API_KEY=
LLM_MODEL_EXTRACT=
LLM_MODEL_SUGGEST=
LLM_DAILY_CALL_BUDGET=200
